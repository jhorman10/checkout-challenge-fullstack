# ==========================================
# Backend Environment Configuration
# Copy this file to `.env` and adjust values.
# ==========================================

PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkout_db
DB_SSL=false

# Wompi API — REQUIRED (non-empty). Get your staging test key from
# https://staging.wompi.co (sandbox credentials start with prv_stagtest_).
WOMPI_ENV=sandbox
WOMPI_API_KEY=prv_stagtest_your_key_here
WOMPI_BASE_URL=https://api-sandbox.co.uat.wompi.dev/v1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MIN=15
RATE_LIMIT_PAYMENT_MAX=5
RATE_LIMIT_PAYMENT_WINDOW_MIN=15
NODE_ENV=development